{
  "name": "@ui/lib",
  "version": "0.0.1",
  "description": "React UI component library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./styles/tokens.scss": "./src/styles/tokens.scss"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc --noEmit && vite build && npm run build:fonts",
    "build:fonts": "sass --no-source-map --style=compressed src/styles/fonts.scss dist/fonts.css && rm -rf dist/fonts && cp -R src/styles/fonts dist/fonts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:contrast": "node scripts/contrast-check.mjs",
    "test:preview": "node scripts/check-vocabulary.mjs",
    "test:poc-css": "node scripts/check-poc-css.mjs",
    "test:palette": "node scripts/check-palette.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.82.0",
    "storybook": "^8.6.18",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.4.0"
  },
  "dependencies": {
    "lucide-react": "^1.23.0"
  }
}
